---
type Props = {
  displayText?: boolean;
};

const { displayText } = Astro.props;
---

<a href="/rss.xml" target="_blank" aria-labelledby="rss-feed-label">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="32"
    height="32"
    fill="currentColor"
    viewBox="0 0 16 16"
  >
    <path
      d="M2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2zm1.5 2.5c5.523 0 10 4.477 10 10a1 1 0 1 1-2 0 8 8 0 0 0-8-8 1 1 0 0 1 0-2m0 4a6 6 0 0 1 6 6 1 1 0 1 1-2 0 4 4 0 0 0-4-4 1 1 0 0 1 0-2m.5 7a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3"
    ></path>
  </svg>
  <span class:list={[{ "sr-only": !displayText }]} id="rss-feed-label"
    >RSS Feed</span
  >
</a>
<style>
  a {
    text-decoration: none;
    color: rgb(var(--gray));
  }
  a:hover {
    color: rgb(var(--gray-dark));
  }

  a {
    display: flex;
    align-items: center;
    gap: 1em;
  }
  a span {
    font-weight: bold;
    font-size: 0.75em;
    text-wrap: balance;
    width: min-content;
    min-width: 11ch;
  }
</style>
