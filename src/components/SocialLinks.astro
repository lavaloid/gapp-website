---
import DiscordLink from "./DiscordLink.astro";
import RssLink from "./RssLink.astro";

type Props = {
  displayText?: boolean;
};

const { displayText } = Astro.props;
---

<div class="social-links">
  <DiscordLink displayText={displayText} />
  <RssLink displayText={displayText} />
</div>
<style>
  .social-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1em;
    text-align: center;
  }
</style>
